  lines:
  - text: "Good... it\u2019s still working."
    voiceover: {fileID: 0}
    displayDuration: 1
    typewriterSpeed: 0.03
  - text: "But it won\u2019t last long..."
    voiceover: {fileID: 0}
    displayDuration: 2
    typewriterSpeed: 0.04
  - text: I need to reach the generator and turn it back on.
    voiceover: {fileID: 0}
    displayDuration: 1.5
    typewriterSpeed: 0.03
  - text: Meanwhile, I'll use what batteries I can find...
    voiceover: {fileID: 0}
    displayDuration: 1.5
    typewriterSpeed: 0.03
  - text: And I can always hide in the closets.
    voiceover: {fileID: 0}
    displayDuration: 1.5
    typewriterSpeed: 0.03
